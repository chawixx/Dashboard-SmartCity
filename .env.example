# AetherSense MQTT Configuration
# HiveMQ Public MQTT WebSocket endpoint
VITE_MQTT_URL=ws://broker.hivemq.com:8000/mqtt

# Default Device ID to monitor ('auto' for auto-detection, or your specific ESP32-S3 MAC ID)
VITE_DEFAULT_DEVICE_ID=auto

# Telemetry and Status Topics (wildcard '+' receives all ESP32-S3 telemetry)
VITE_MQTT_TELEMETRY_TOPIC=aethersense/+/telemetry
VITE_MQTT_STATUS_TOPIC=aethersense/+/status
